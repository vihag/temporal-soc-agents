# Fixture mode is the default: no API key, no spend. Copy to .env.
GROK_CLIENT=fixture
# GROK_CLIENT=http
# XAI_API_KEY=
XAI_MODEL=grok-4.3
LLM_MAX_TOKENS=800
MAX_AGENT_STEPS=6
ENABLE_THREAT=1
APPROVAL_TIMEOUT_S=120
FIXTURE_LATENCY_S=0.7
# Local mocks (defaults shown): Mock Grok replays recorded model turns; the queue is SQS-like.
# MOCK_GROK_URL=http://127.0.0.1:8003/v1
# QUEUE_URL=http://127.0.0.1:8004
TEMPORAL_UI_URL=http://localhost:8233
# Temporal Cloud: set TEMPORAL_ADDRESS, TEMPORAL_NAMESPACE, TEMPORAL_API_KEY (and TEMPORAL_TLS=true)
# Temporal-complete extras (all optional):
# SEARCH_ATTRIBUTES=1          # index cases for Visibility (0 = one Query per case)
# LLM_RATE_PER_S=5             # model calls per second on the -llm task queue (server-enforced)
# SOC_CODEC_KEY=               # base64 32-byte key: encrypt payloads (openssl rand -base64 32)
# CODEC_CORS_ORIGINS=http://localhost:8233
# METRICS_BIND=0.0.0.0:9464    # Prometheus SDK metrics
